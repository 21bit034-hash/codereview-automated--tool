#!/bin/bash

echo "👀 Watching for WPCS results..."
echo "   Press Ctrl+C to stop watching"
echo ""

# Wait for results file
while true; do
  if [ -f /tmp/wpcs-output.log ]; then
    clear
    cat /tmp/wpcs-output.log
    if grep -q "PASSED\|FAILED" /tmp/wpcs-output.log; then
      echo ""
      echo "✅ WPCS check complete!"
      rm -f /tmp/wpcs-output.log
      break
    fi
  fi
  sleep 3
done

