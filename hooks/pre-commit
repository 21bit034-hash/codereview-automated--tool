#!/bin/bash

echo ""
echo "================================"
echo "   WPCS Pre-commit Check"
echo "================================"
echo ""

# Run WPCS
./vendor/bin/phpcs \
  --standard=WordPress \
  --extensions=php \
  --ignore=vendor/ \
  .

# Check result
if [ $? -ne 0 ]; then
  echo ""
  echo "================================"
  echo " Status : ❌ FAILED"
  echo " Fix errors and commit again!"
  echo "================================"
  exit 1
else
  echo ""
  echo "================================"
  echo " Status : ✅ PASSED"
  echo " Committing your code..."
  echo "================================"
  exit 0
fi
